# ailedger-detection monitoring — environment configuration
#
# Copy to `.env` and edit. `setup-datasources.sh` reads this file and renders
# grafana/provisioning/datasources/datasources.yaml from datasources.yaml.tmpl.
# docker-compose.yml also reads it.
#
# Every value has a safe default for a single-ship local deployment.

# ── Identity ────────────────────────────────────────────────────────────────
# Logical name of THIS ship. Surfaces as the `ship` label / dashboard variable.
SHIP_NAME=local

# Deployment mode: "ship" (one ship's data) or "fleet" (rollup across ships).
# In fleet mode, edit datasources.yaml.tmpl to add one MySQL + one Infinity
# datasource per ship (see README "Fleet rollup").
DEPLOY_MODE=ship

# ── Grafana ─────────────────────────────────────────────────────────────────
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
# Set a real password before any non-localhost exposure.
GRAFANA_ADMIN_PASSWORD=admin
# Comma-separated plugins installed on container start. Infinity is required
# for the events.jsonl / churn-log.jsonl panels.
GRAFANA_PLUGINS=yesoreyeram-infinity-datasource

# ── AILedger Decision Event store (PostgreSQL / Supabase) — LARP panels ───────
# Leave AILEDGER_PG_HOST empty to skip provisioning the AILedger datasource
# (e.g. on a ship with no Decision Event store). The LARP dashboard then shows
# "No data" rather than erroring.
AILEDGER_PG_HOST=
AILEDGER_PG_PORT=5432
AILEDGER_PG_DATABASE=postgres
AILEDGER_PG_USER=grafana_ro
AILEDGER_PG_PASSWORD=
# Schema holding decision_events. Queries are schema-qualified as `ledger.*`.
AILEDGER_PG_SSLMODE=require

# ── Dolt / beads (MySQL wire protocol) — GUPP fleet panels ────────────────────
# Dolt serves the MySQL protocol; Grafana's MySQL datasource connects directly.
DOLT_HOST=host.docker.internal
DOLT_PORT=3307
DOLT_DATABASE=hq
DOLT_USER=root
DOLT_PASSWORD=

# ── Event streams (Infinity datasource) — GUPP + dolt-health panels ───────────
# Mounted read-only into the Grafana container at /streams. Point these at the
# town root's .events.jsonl and churn-log.jsonl.
EVENTS_JSONL_HOST_PATH=../../.events.jsonl
CHURN_LOG_HOST_PATH=../../churn-log.jsonl
